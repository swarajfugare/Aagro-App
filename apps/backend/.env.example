# ==============================================================================
# NESTJS BACKEND API (.env.example)
# Agriculture Supply Chain Management System
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_BASE_URL=http://localhost:5173

# CORS (Comma-separated origins or *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Connection (MySQL / Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/agri_supply_chain"

# Firebase Admin SDK Configuration (Authentication & FCM)
# In production, set these or specify path to service account JSON
FIREBASE_PROJECT_ID=placeholder-firebase-project-id
FIREBASE_CLIENT_EMAIL=placeholder-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"
# Optional direct path to Firebase Service Account credentials JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-credentials.json

# File Storage Configuration (Hostinger Business / Local)
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Maps & Navigation Services (OpenStreetMap / openrouteservice)
MAP_TILE_PROVIDER=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTING_PROVIDER=openrouteservice
ROUTING_API_KEY=placeholder-openrouteservice-api-key

# External Data Services
WEATHER_API_KEY=placeholder-weather-api-key
MARKET_PRICE_API_KEY=placeholder-market-price-api-key
