// Prisma Schema - Agriculture Supply Chain Management System
// Phase 2: Complete Relational Database Foundation for MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  STAFF
  FARMER
  DRIVER
  BUYER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum QuantityUnit {
  KG
  QUINTAL
  METRIC_TON
  LITRE
  CRATE
  BAG
}

enum AreaUnit {
  ACRE
  HECTARE
  GUNTHA
  SQ_METER
}

enum CropHealthStatus {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DISEASED
}

enum ProductionStatus {
  PLANNED
  GROWING
  READY_FOR_HARVEST
  HARVESTED
  FAILED
}

enum HarvestStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SupplyStatus {
  DRAFT
  AVAILABLE
  PARTIALLY_MATCHED
  FULLY_MATCHED
  RESERVED
  SOLD
  EXPIRED
  CANCELLED
}

enum RequirementStatus {
  DRAFT
  OPEN
  MATCHING
  PARTIALLY_MATCHED
  FULLY_MATCHED
  ORDERED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum MatchStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  MATCHING
  MATCHED
  CONFIRMED
  DRIVER_ASSIGNED
  PICKUP_SCHEDULED
  PICKUP_IN_PROGRESS
  PICKED_UP
  IN_TRANSIT
  DELIVERY_ATTEMPTED
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  REJECTED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFFLINE
  SUSPENDED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum TripStatus {
  PLANNED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStopType {
  PICKUP
  DELIVERY
}

enum TripStopStatus {
  PENDING
  EN_ROUTE
  ARRIVED
  COMPLETED
  FAILED
  SKIPPED
}

enum PickupStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  LOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  ARRIVING
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CASH_ON_DELIVERY
  WALLET
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  OVERDUE
}

enum NotificationType {
  SYSTEM
  ORDER_UPDATE
  MATCH_ALERT
  WEATHER_ALERT
  PRICE_ALERT
  TRIP_DISPATCH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==============================================================================
// 1. USER & ACCESS CONTROL (RBAC)
// ==============================================================================

model User {
  id          String     @id @default(uuid())
  firebaseUid String     @unique @map("firebase_uid")
  email       String?    @unique
  phone       String?    @unique
  fullName    String     @map("full_name")
  avatarUrl   String?    @map("avatar_url")
  status      UserStatus @default(PENDING_VERIFICATION)
  roleId      String     @map("role_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  role              Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  farmerProfile     Farmer?
  buyerProfile      Buyer?
  driverProfile     Driver?
  auditLogs         AuditLog[]
  notifications     Notification[]
  supportTickets    SupportTicket[]      @relation("UserTickets")
  assignedTickets   SupportTicket[]      @relation("AssignedTickets")
  paymentsPaid      Payment[]            @relation("PayerUser")
  paymentsReceived  Payment[]            @relation("PayeeUser")
  statusChangesMade OrderStatusHistory[] @relation("StatusChangedBy")
  uploads           Upload[]

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==============================================================================
// 2. LOCATION HIERARCHY
// ==============================================================================

model State {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  districts    District[]
  marketPrices MarketPrice[]
  weatherData  WeatherData[]

  @@map("states")
}

model District {
  id        String   @id @default(uuid())
  stateId   String   @map("state_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  state        State         @relation(fields: [stateId], references: [id], onDelete: Restrict)
  villages     Village[]
  marketPrices MarketPrice[]
  weatherData  WeatherData[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("districts")
}

model Village {
  id         String   @id @default(uuid())
  districtId String   @map("district_id")
  name       String
  postalCode String?  @map("postal_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  district          District           @relation(fields: [districtId], references: [id], onDelete: Restrict)
  farmers           Farmer[]
  farms             Farm[]
  buyers            Buyer[]
  buyerRequirements BuyerRequirement[]

  @@index([districtId])
  @@index([postalCode])
  @@map("villages")
}

// ==============================================================================
// 3. FARMER & FARM
// ==============================================================================

model Farmer {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  villageId         String?            @map("village_id")
  kycStatus         VerificationStatus @default(PENDING) @map("kyc_status")
  kycDocumentNumber String?            @map("kyc_document_number")
  idProofType       String?            @map("id_proof_type")
  address           String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  village         Village?         @relation(fields: [villageId], references: [id], onDelete: SetNull)
  farms           Farm[]
  farmerCrops     FarmerCrop[]
  supplyBatches   SupplyBatch[]
  farmerDocuments FarmerDocument[]
  orderItems      OrderItem[]
  pickupRecords   PickupRecord[]

  @@index([kycStatus])
  @@index([villageId])
  @@map("farmers")
}

model Farm {
  id        String   @id @default(uuid())
  farmerId  String   @map("farmer_id")
  name      String
  area      Decimal  @db.Decimal(10, 2)
  areaUnit  AreaUnit @default(ACRE) @map("area_unit")
  villageId String?  @map("village_id")
  address   String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  farmer      Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  village     Village?     @relation(fields: [villageId], references: [id], onDelete: SetNull)
  farmerCrops FarmerCrop[]

  @@index([farmerId])
  @@index([villageId])
  @@index([isActive])
  @@map("farms")
}

model FarmerDocument {
  id                 String             @id @default(uuid())
  farmerId           String             @map("farmer_id")
  title              String
  documentType       String             @map("document_type")
  fileUrl            String             @map("file_url")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([verificationStatus])
  @@map("farmer_documents")
}

// ==============================================================================
// 4. CROPS, PRODUCTION & SUPPLY
// ==============================================================================

model Crop {
  id             String   @id @default(uuid())
  name           String   @unique
  scientificName String?  @map("scientific_name")
  category       String
  description    String?  @db.Text
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  varieties         CropVariety[]
  farmerCrops       FarmerCrop[]
  supplyBatches     SupplyBatch[]
  buyerRequirements BuyerRequirement[]
  marketPrices      MarketPrice[]

  @@index([category])
  @@map("crops")
}

model CropVariety {
  id           String   @id @default(uuid())
  cropId       String   @map("crop_id")
  name         String
  description  String?
  season       String?
  maturityDays Int?     @map("maturity_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  crop              Crop               @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmerCrops       FarmerCrop[]
  supplyBatches     SupplyBatch[]
  buyerRequirements BuyerRequirement[]
  marketPrices      MarketPrice[]

  @@unique([cropId, name])
  @@index([cropId])
  @@map("crop_varieties")
}

model FarmerCrop {
  id                  String           @id @default(uuid())
  farmerId            String           @map("farmer_id")
  farmId              String           @map("farm_id")
  cropId              String           @map("crop_id")
  varietyId           String?          @map("variety_id")
  areaSown            Decimal          @map("area_sown") @db.Decimal(10, 2)
  areaUnit            AreaUnit         @default(ACRE) @map("area_unit")
  sowingDate          DateTime         @map("sowing_date")
  expectedHarvestDate DateTime?        @map("expected_harvest_date")
  status              ProductionStatus @default(GROWING)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Relations
  farmer         Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm           Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop           Crop             @relation(fields: [cropId], references: [id], onDelete: Restrict)
  variety        CropVariety?     @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  productions    CropProduction[]
  cropHealthLogs CropHealth[]
  harvests       Harvest[]
  supplyBatches  SupplyBatch[]

  @@index([farmerId])
  @@index([farmId])
  @@index([cropId])
  @@index([status])
  @@map("farmer_crops")
}

model CropProduction {
  id               String           @id @default(uuid())
  farmerCropId     String           @map("farmer_crop_id")
  estimatedYield   Decimal          @map("estimated_yield") @db.Decimal(10, 2)
  yieldUnit        QuantityUnit     @default(KG) @map("yield_unit")
  productionStatus ProductionStatus @default(GROWING) @map("production_status")
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  farmerCrop FarmerCrop @relation(fields: [farmerCropId], references: [id], onDelete: Cascade)

  @@index([farmerCropId])
  @@map("crop_production")
}

model CropHealth {
  id           String           @id @default(uuid())
  farmerCropId String           @map("farmer_crop_id")
  status       CropHealthStatus @default(GOOD)
  observation  String?          @db.Text
  diagnosis    String?          @db.Text
  photoUrl     String?          @map("photo_url")
  recordedDate DateTime         @default(now()) @map("recorded_date")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  farmerCrop FarmerCrop @relation(fields: [farmerCropId], references: [id], onDelete: Cascade)

  @@index([farmerCropId])
  @@index([recordedDate])
  @@map("crop_health")
}

model Harvest {
  id               String        @id @default(uuid())
  farmerCropId     String        @map("farmer_crop_id")
  expectedQuantity Decimal       @map("expected_quantity") @db.Decimal(10, 2)
  actualQuantity   Decimal?      @map("actual_quantity") @db.Decimal(10, 2)
  unit             QuantityUnit  @default(KG)
  harvestDate      DateTime      @map("harvest_date")
  status           HarvestStatus @default(SCHEDULED)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  farmerCrop    FarmerCrop    @relation(fields: [farmerCropId], references: [id], onDelete: Cascade)
  supplyBatches SupplyBatch[]

  @@index([farmerCropId])
  @@index([harvestDate])
  @@index([status])
  @@map("harvests")
}

model SupplyBatch {
  id                String       @id @default(uuid())
  farmerId          String       @map("farmer_id")
  farmerCropId      String?      @map("farmer_crop_id")
  harvestId         String?      @map("harvest_id")
  batchNumber       String       @unique @map("batch_number")
  cropId            String       @map("crop_id")
  varietyId         String?      @map("variety_id")
  quantity          Decimal      @db.Decimal(10, 2)
  remainingQuantity Decimal      @map("remaining_quantity") @db.Decimal(10, 2)
  unit              QuantityUnit @default(KG)
  qualityGrade      String       @default("A") @map("quality_grade")
  basePricePerUnit  Decimal?     @map("base_price_per_unit") @db.Decimal(10, 2)
  currency          String       @default("INR")
  availableFrom     DateTime     @map("available_from")
  availableUntil    DateTime?    @map("available_until")
  status            SupplyStatus @default(AVAILABLE)
  notes             String?      @db.Text
  photoUrl          String?      @map("photo_url")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  farmer        Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  farmerCrop    FarmerCrop?    @relation(fields: [farmerCropId], references: [id], onDelete: SetNull)
  harvest       Harvest?       @relation(fields: [harvestId], references: [id], onDelete: SetNull)
  crop          Crop           @relation(fields: [cropId], references: [id], onDelete: Restrict)
  variety       CropVariety?   @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  matchItems    MatchItem[]
  orderItems    OrderItem[]
  pickupRecords PickupRecord[]

  @@index([farmerId])
  @@index([cropId])
  @@index([status])
  @@index([availableFrom])
  @@map("supply_batches")
}

// ==============================================================================
// 5. BUYER & DEMAND
// ==============================================================================

model Buyer {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  companyName        String?            @map("company_name")
  businessType       String?            @map("business_type")
  gstNumber          String?            @unique @map("gst_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  address            String?
  villageId          String?            @map("village_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  village         Village?           @relation(fields: [villageId], references: [id], onDelete: SetNull)
  requirements    BuyerRequirement[]
  orders          Order[]
  deliveryRecords DeliveryRecord[]
  invoices        Invoice[]

  @@index([verificationStatus])
  @@index([villageId])
  @@map("buyers")
}

model BuyerRequirement {
  id                String            @id @default(uuid())
  buyerId           String            @map("buyer_id")
  requirementNumber String            @unique @map("requirement_number")
  cropId            String            @map("crop_id")
  varietyId         String?           @map("variety_id")
  targetQuantity    Decimal           @map("target_quantity") @db.Decimal(10, 2)
  remainingQuantity Decimal           @map("remaining_quantity") @db.Decimal(10, 2)
  unit              QuantityUnit      @default(KG)
  qualityGrade      String            @default("A") @map("quality_grade")
  maxPricePerUnit   Decimal?          @map("max_price_per_unit") @db.Decimal(10, 2)
  currency          String            @default("INR")
  requiredByDate    DateTime          @map("required_by_date")
  deliveryAddress   String            @map("delivery_address")
  deliveryVillageId String?           @map("delivery_village_id")
  deliveryLatitude  Decimal?          @map("delivery_latitude") @db.Decimal(10, 8)
  deliveryLongitude Decimal?          @map("delivery_longitude") @db.Decimal(11, 8)
  status            RequirementStatus @default(OPEN)
  notes             String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  buyer           Buyer               @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  crop            Crop                @relation(fields: [cropId], references: [id], onDelete: Restrict)
  variety         CropVariety?        @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  deliveryVillage Village?            @relation(fields: [deliveryVillageId], references: [id], onDelete: SetNull)
  matches         SupplyDemandMatch[]

  @@index([buyerId])
  @@index([cropId])
  @@index([status])
  @@index([requiredByDate])
  @@map("buyer_requirements")
}

// ==============================================================================
// 6. MATCHING & ALLOCATION
// ==============================================================================

model SupplyDemandMatch {
  id                   String       @id @default(uuid())
  requirementId        String       @map("requirement_id")
  totalMatchedQuantity Decimal      @map("total_matched_quantity") @db.Decimal(10, 2)
  unit                 QuantityUnit @default(KG)
  status               MatchStatus  @default(PROPOSED)
  score                Decimal?     @db.Decimal(5, 2)
  notes                String?      @db.Text
  matchedAt            DateTime     @default(now()) @map("matched_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relations
  requirement BuyerRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  matchItems  MatchItem[]
  orders      Order[]

  @@index([requirementId])
  @@index([status])
  @@map("supply_demand_matches")
}

model MatchItem {
  id                String       @id @default(uuid())
  matchId           String       @map("match_id")
  supplyBatchId     String       @map("supply_batch_id")
  allocatedQuantity Decimal      @map("allocated_quantity") @db.Decimal(10, 2)
  unit              QuantityUnit @default(KG)
  unitPrice         Decimal?     @map("unit_price") @db.Decimal(10, 2)
  currency          String       @default("INR")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  match       SupplyDemandMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  supplyBatch SupplyBatch       @relation(fields: [supplyBatchId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([supplyBatchId])
  @@map("match_items")
}

// ==============================================================================
// 7. ORDERS & LIFECYCLE
// ==============================================================================

model Order {
  id                String       @id @default(uuid())
  orderNumber       String       @unique @map("order_number")
  buyerId           String       @map("buyer_id")
  matchId           String?      @map("match_id")
  totalQuantity     Decimal      @map("total_quantity") @db.Decimal(10, 2)
  unit              QuantityUnit @default(KG)
  totalAmount       Decimal      @map("total_amount") @db.Decimal(12, 2)
  currency          String       @default("INR")
  deliveryAddress   String       @map("delivery_address")
  deliveryLatitude  Decimal?     @map("delivery_latitude") @db.Decimal(10, 8)
  deliveryLongitude Decimal?     @map("delivery_longitude") @db.Decimal(11, 8)
  status            OrderStatus  @default(DRAFT)
  notes             String?      @db.Text
  confirmedAt       DateTime?    @map("confirmed_at")
  completedAt       DateTime?    @map("completed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  buyer           Buyer                @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  match           SupplyDemandMatch?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  statusHistory   OrderStatusHistory[]
  trips           Trip[]
  deliveryRecords DeliveryRecord[]
  payments        Payment[]
  invoices        Invoice[]

  @@index([buyerId])
  @@index([matchId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String       @id @default(uuid())
  orderId       String       @map("order_id")
  supplyBatchId String       @map("supply_batch_id")
  farmerId      String       @map("farmer_id")
  quantity      Decimal      @db.Decimal(10, 2)
  unit          QuantityUnit @default(KG)
  unitPrice     Decimal      @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal      @map("total_price") @db.Decimal(12, 2)
  currency      String       @default("INR")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplyBatch SupplyBatch @relation(fields: [supplyBatchId], references: [id], onDelete: Restrict)
  farmer      Farmer      @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([supplyBatchId])
  @@index([farmerId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String       @map("order_id")
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  reason          String?      @db.Text
  changedByUserId String?      @map("changed_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

// ==============================================================================
// 8. DRIVERS & VEHICLES
// ==============================================================================

model Driver {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  licenseNumber      String             @unique @map("license_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  status             DriverStatus       @default(OFFLINE)
  experienceYears    Int?               @map("experience_years")
  currentLatitude    Decimal?           @map("current_latitude") @db.Decimal(10, 8)
  currentLongitude   Decimal?           @map("current_longitude") @db.Decimal(11, 8)
  lastLocationUpdate DateTime?          @map("last_location_update")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]
  trips           Trip[]
  driverDocuments DriverDocument[]
  driverLocations DriverLocation[]

  @@index([verificationStatus])
  @@index([status])
  @@map("drivers")
}

model Vehicle {
  id                 String             @id @default(uuid())
  driverId           String             @map("driver_id")
  vehicleNumber      String             @unique @map("vehicle_number")
  vehicleType        String             @map("vehicle_type")
  capacity           Decimal            @db.Decimal(10, 2)
  capacityUnit       QuantityUnit       @default(METRIC_TON) @map("capacity_unit")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  status             VehicleStatus      @default(ACTIVE)
  make               String?
  model              String?
  year               Int?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  trips  Trip[]

  @@index([driverId])
  @@index([status])
  @@map("vehicles")
}

model DriverDocument {
  id                 String             @id @default(uuid())
  driverId           String             @map("driver_id")
  documentType       String             @map("document_type")
  documentNumber     String?            @map("document_number")
  fileUrl            String             @map("file_url")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  expiryDate         DateTime?          @map("expiry_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([verificationStatus])
  @@map("driver_documents")
}

// ==============================================================================
// 9. LOGISTICS, TRIPS & STOPS
// ==============================================================================

model Trip {
  id                       String       @id @default(uuid())
  tripNumber               String       @unique @map("trip_number")
  driverId                 String       @map("driver_id")
  vehicleId                String       @map("vehicle_id")
  orderId                  String?      @map("order_id")
  totalDistanceKm          Decimal?     @map("total_distance_km") @db.Decimal(8, 2)
  estimatedDurationMinutes Int?         @map("estimated_duration_minutes")
  totalPlannedLoad         Decimal      @map("total_planned_load") @db.Decimal(10, 2)
  loadUnit                 QuantityUnit @default(KG) @map("load_unit")
  status                   TripStatus   @default(PLANNED)
  startTime                DateTime?    @map("start_time")
  endTime                  DateTime?    @map("end_time")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  // Relations
  driver          Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tripStops       TripStop[]
  pickupRecords   PickupRecord[]
  deliveryRecords DeliveryRecord[]
  routes          Route[]
  driverLocations DriverLocation[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("trips")
}

model TripStop {
  id               String         @id @default(uuid())
  tripId           String         @map("trip_id")
  stopOrder        Int            @map("stop_order")
  stopType         TripStopType   @map("stop_type")
  status           TripStopStatus @default(PENDING)
  address          String
  latitude         Decimal        @db.Decimal(10, 8)
  longitude        Decimal        @db.Decimal(11, 8)
  estimatedArrival DateTime?      @map("estimated_arrival")
  actualArrival    DateTime?      @map("actual_arrival")
  completedAt      DateTime?      @map("completed_at")
  notes            String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pickupRecords   PickupRecord[]
  deliveryRecords DeliveryRecord[]

  @@unique([tripId, stopOrder])
  @@index([tripId])
  @@index([status])
  @@map("trip_stops")
}

model PickupRecord {
  id              String       @id @default(uuid())
  tripId          String       @map("trip_id")
  tripStopId      String?      @map("trip_stop_id")
  supplyBatchId   String       @map("supply_batch_id")
  farmerId        String       @map("farmer_id")
  plannedQuantity Decimal      @map("planned_quantity") @db.Decimal(10, 2)
  actualQuantity  Decimal?     @map("actual_quantity") @db.Decimal(10, 2)
  unit            QuantityUnit @default(KG)
  qualityGrade    String?      @map("quality_grade")
  status          PickupStatus @default(PENDING)
  remarks         String?      @db.Text
  evidenceUrl     String?      @map("evidence_url")
  pickedUpAt      DateTime?    @map("picked_up_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripStop    TripStop?   @relation(fields: [tripStopId], references: [id], onDelete: SetNull)
  supplyBatch SupplyBatch @relation(fields: [supplyBatchId], references: [id], onDelete: Restrict)
  farmer      Farmer      @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([tripStopId])
  @@index([supplyBatchId])
  @@index([farmerId])
  @@index([status])
  @@map("pickup_records")
}

model DeliveryRecord {
  id              String         @id @default(uuid())
  tripId          String         @map("trip_id")
  tripStopId      String?        @map("trip_stop_id")
  orderId         String         @map("order_id")
  buyerId         String         @map("buyer_id")
  plannedQuantity Decimal        @map("planned_quantity") @db.Decimal(10, 2)
  actualQuantity  Decimal?       @map("actual_quantity") @db.Decimal(10, 2)
  unit            QuantityUnit   @default(KG)
  status          DeliveryStatus @default(PENDING)
  remarks         String?        @db.Text
  deliveredAt     DateTime?      @map("delivered_at")
  receiverName    String?        @map("receiver_name")
  receiverPhone   String?        @map("receiver_phone")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  trip            Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripStop        TripStop?         @relation(fields: [tripStopId], references: [id], onDelete: SetNull)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer           Buyer             @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  proofOfDelivery ProofOfDelivery[]

  @@index([tripId])
  @@index([tripStopId])
  @@index([orderId])
  @@index([buyerId])
  @@index([status])
  @@map("delivery_records")
}

model ProofOfDelivery {
  id               String   @id @default(uuid())
  deliveryRecordId String   @map("delivery_record_id")
  photoUrl         String?  @map("photo_url")
  signatureUrl     String?  @map("signature_url")
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  deliveryRecord DeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Cascade)

  @@index([deliveryRecordId])
  @@map("proof_of_delivery")
}

// ==============================================================================
// 10. ROUTES & GEOLOCATION TRACKING
// ==============================================================================

model Route {
  id               String   @id @default(uuid())
  tripId           String   @map("trip_id")
  provider         String   @default("openrouteservice")
  distanceKm       Decimal  @map("distance_km") @db.Decimal(8, 2)
  durationMinutes  Int      @map("duration_minutes")
  overviewPolyline String?  @map("overview_polyline") @db.LongText
  startLatitude    Decimal  @map("start_latitude") @db.Decimal(10, 8)
  startLongitude   Decimal  @map("start_longitude") @db.Decimal(11, 8)
  endLatitude      Decimal  @map("end_latitude") @db.Decimal(10, 8)
  endLongitude     Decimal  @map("end_longitude") @db.Decimal(11, 8)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  routePoints RoutePoint[]

  @@index([tripId])
  @@map("routes")
}

model RoutePoint {
  id            String   @id @default(uuid())
  routeId       String   @map("route_id")
  sequenceOrder Int      @map("sequence_order")
  latitude      Decimal  @db.Decimal(10, 8)
  longitude     Decimal  @db.Decimal(11, 8)
  stopName      String?  @map("stop_name")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, sequenceOrder])
  @@map("route_points")
}

model DriverLocation {
  id         String   @id @default(uuid())
  driverId   String   @map("driver_id")
  tripId     String?  @map("trip_id")
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  speed      Decimal? @db.Decimal(5, 2)
  heading    Decimal? @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([driverId, recordedAt])
  @@index([tripId])
  @@map("driver_locations")
}

// ==============================================================================
// 11. MARKET PRICES & WEATHER
// ==============================================================================

model MarketPrice {
  id         String       @id @default(uuid())
  cropId     String       @map("crop_id")
  varietyId  String?      @map("variety_id")
  marketName String       @map("market_name")
  districtId String?      @map("district_id")
  stateId    String?      @map("state_id")
  minPrice   Decimal      @map("min_price") @db.Decimal(10, 2)
  maxPrice   Decimal      @map("max_price") @db.Decimal(10, 2)
  avgPrice   Decimal      @map("avg_price") @db.Decimal(10, 2)
  unit       QuantityUnit @default(QUINTAL)
  currency   String       @default("INR")
  priceDate  DateTime     @map("price_date")
  source     String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // Relations
  crop     Crop         @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety  CropVariety? @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  district District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)
  state    State?       @relation(fields: [stateId], references: [id], onDelete: SetNull)

  @@index([cropId, priceDate])
  @@index([districtId])
  @@index([stateId])
  @@map("market_prices")
}

model WeatherData {
  id                       String   @id @default(uuid())
  districtId               String?  @map("district_id")
  stateId                  String?  @map("state_id")
  latitude                 Decimal? @db.Decimal(10, 8)
  longitude                Decimal? @db.Decimal(11, 8)
  temperature              Decimal? @db.Decimal(5, 2)
  humidity                 Decimal? @db.Decimal(5, 2)
  precipitationProbability Decimal? @map("precipitation_probability") @db.Decimal(5, 2)
  weatherCondition         String?  @map("weather_condition")
  advisory                 String?  @db.Text
  recordedAt               DateTime @default(now()) @map("recorded_at")
  createdAt                DateTime @default(now()) @map("created_at")

  // Relations
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  state    State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)

  @@index([districtId, recordedAt])
  @@index([stateId])
  @@map("weather_data")
}

// ==============================================================================
// 12. FINANCIAL & INVOICES
// ==============================================================================

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  payerUserId      String        @map("payer_user_id")
  payeeUserId      String?       @map("payee_user_id")
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  paymentReference String?       @map("payment_reference")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payer        User                 @relation("PayerUser", fields: [payerUserId], references: [id], onDelete: Restrict)
  payee        User?                @relation("PayeeUser", fields: [payeeUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([orderId])
  @@index([payerUserId])
  @@index([status])
  @@map("payments")
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  paymentId         String        @map("payment_id")
  transactionNumber String        @unique @map("transaction_number")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  gateway           String?
  status            PaymentStatus @default(PENDING)
  responsePayload   String?       @map("response_payload") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("payment_transactions")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  orderId       String        @map("order_id")
  buyerId       String        @map("buyer_id")
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency      String        @default("INR")
  status        InvoiceStatus @default(ISSUED)
  invoicePdfUrl String?       @map("invoice_pdf_url")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  dueDate       DateTime?     @map("due_date")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([buyerId])
  @@index([status])
  @@map("invoices")
}

// ==============================================================================
// 13. NOTIFICATIONS
// ==============================================================================

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  title       String
  message     String           @db.Text
  type        NotificationType @default(SYSTEM)
  isRead      Boolean          @default(false) @map("is_read")
  dataPayload String?          @map("data_payload") @db.Text
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  // Relations
  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs NotificationLog[]

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id              String   @id @default(uuid())
  notificationId  String   @map("notification_id")
  channel         String   @default("FCM")
  recipientToken  String?  @map("recipient_token")
  status          String
  responseMessage String?  @map("response_message") @db.Text
  sentAt          DateTime @default(now()) @map("sent_at")

  // Relations
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_logs")
}

// ==============================================================================
// 14. UPLOADS & DOCUMENTS
// ==============================================================================

model Upload {
  id           String   @id @default(uuid())
  ownerUserId  String?  @map("owner_user_id")
  fileName     String   @map("file_name")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    BigInt   @map("size_bytes")
  storagePath  String   @map("storage_path")
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  isPrivate    Boolean  @default(false) @map("is_private")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([entityType, entityId])
  @@map("uploads")
}

// ==============================================================================
// 15. SUPPORT TICKETS
// ==============================================================================

model SupportTicket {
  id               String         @id @default(uuid())
  ticketNumber     String         @unique @map("ticket_number")
  userId           String         @map("user_id")
  subject          String
  description      String         @db.Text
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  assignedToUserId String?        @map("assigned_to_user_id")
  resolvedAt       DateTime?      @map("resolved_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  user       User  @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

// ==============================================================================
// 16. AUDIT LOGS & SYSTEM SETTINGS
// ==============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  previousValues String?  @map("previous_values") @db.LongText
  newValues      String?  @map("new_values") @db.LongText
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Retained for baseline health check verification
model SystemHealth {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_health")
}
